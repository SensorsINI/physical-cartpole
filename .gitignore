# Vitis HLS build artifacts
/FPGA/CustomIPs/**/csim/
/FPGA/CustomIPs/vitis_hls.log
/FPGA/CustomIPs/**/.autopilot/
/FPGA/CustomIPs/**/.debug/
# Ignore HLS impl staging, but keep the packaged IP (referenced by the
# Vivado block designs as xilinx.com:hls:median_filter:1.0)
/FPGA/CustomIPs/**/impl/*
!/FPGA/CustomIPs/**/impl/ip/
/FPGA/CustomIPs/**/syn/
/FPGA/CustomIPs/**/.apc/
/FPGA/CustomIPs/**/.settings/
/FPGA/CustomIPs/**/.cproject
/FPGA/CustomIPs/**/.project
/FPGA/CustomIPs/**/.vitis_hls_log_all.xml
/FPGA/CustomIPs/**/hls.app
/FPGA/CustomIPs/**/*.log
/FPGA/CustomIPs/**/*.jou
/FPGA/CustomIPs/**/*.aps
/FPGA/CustomIPs/**/*_data.json
/FPGA/CustomIPs/**/*.directive
/FPGA/CustomIPs/**/*.funcunit
/FPGA/CustomIPs/**/directives.tcl
/FPGA/CustomIPs/**/script.tcl
/FPGA/CustomIPs/**/*.protoinst
# HLS csim binaries staged next to the sources (secloc_shell_hls/run_tb.sh)
/FPGA/CustomIPs/**/*.o
/FPGA/CustomIPs/**/a.out
# Vivado IP-packaging staging inside committed HLS impl/ip trees
/FPGA/CustomIPs/**/impl/ip/tmp.srcs/
/FPGA/CustomIPs/**/impl/ip/tmp.xpr
/FPGA/CustomIPs/**/impl/ip/tmp.cache/
/FPGA/CustomIPs/**/impl/ip/tmp.hw/
# Packaged zip duplicate of impl/ip (Vivado uses the directory)
/FPGA/CustomIPs/**/impl/ip/*.zip

.pytest_cache/

/Firmware/VitisProjects/*
/Firmware/*.str
